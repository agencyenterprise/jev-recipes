  "bin": {
    "jev-recipes": "dist/cli/index.js"
  },
  "files": [
    "dist/src/**/*.js",
    "dist/src/**/*.d.ts",
    "dist/recipes/**/*.js",
    "dist/recipes/**/*.d.ts",
    "dist/catalog/**/*.js",
    "dist/catalog/**/*.d.ts",
    "dist/catalog/generated/details/*.json",
    "dist/cli/*.js",
    "dist/cli/*.d.ts",
    "dist/recipes/*/demo.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "docs": "node scripts/generate.mjs --docs",
    "new": "node scripts/new-recipe.mjs",
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/build-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo": "node dist/cli/index.js demo all",
    "jev-recipes": "node --env-file-if-exists=.env dist/cli/index.js",
    "ci": "node scripts/ci.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "prepack": "npm run generate:check && npm run build",
    "prepublishOnly": "npm run ci",
    "test": "npm run test:recipes && npm run test:tooling",
    "test:recipes": "vitest run",
    "test:tooling": "npm run build && node scripts/test-tooling.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "4.1.11",
    "prettier": "3.9.8",
    "rimraf": "6.1.3",
    "typescript": "~5.9.3",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  },
  "homepage": "https://github.com/agencyenterprise/jev-recipes#readme",
  "bugs": {
    "url": "https://github.com/agencyenterprise/jev-recipes/issues"
  },
  "keywords": [
    "jev",
    "typesafe",
    "recipes",
    "ai",
    "routing",
    "reranking",
    "rag",
    "evidence",
    "typescript",
    "cli"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
