{
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "disclosure": { "type": "string" },
      "minConfidence": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "required": ["disclosure"]
  },
  "resultSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "model": { "type": "string" },
      "usage": {
        "type": "object",
        "properties": {
          "input_tokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "output_tokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        },
        "required": ["input_tokens", "output_tokens"],
        "additionalProperties": false
      },
      "status": { "type": "string", "enum": ["ready", "review"] },
      "detected": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "statesKnownDefects",
            "statesPriorRepairs",
            "statesEnvironmentalHazards",
            "statesBoundaryIssues",
            "statesAssociationRules"
          ]
        }
      },
      "labels": {
        "type": "object",
        "properties": {
          "statesKnownDefects": {
            "type": "object",
            "properties": {
              "status": { "type": "string", "enum": ["ready", "review"] },
              "verdict": { "type": "string", "enum": ["present", "absent"] },
              "probability": { "type": "number", "minimum": 0, "maximum": 1 },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "required": ["status", "verdict", "probability", "confidence"],
            "additionalProperties": false
          },
          "statesPriorRepairs": {
            "type": "object",
            "properties": {
              "status": { "type": "string", "enum": ["ready", "review"] },
              "verdict": { "type": "string", "enum": ["present", "absent"] },
              "probability": { "type": "number", "minimum": 0, "maximum": 1 },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "required": ["status", "verdict", "probability", "confidence"],
            "additionalProperties": false
          },
          "statesEnvironmentalHazards": {
            "type": "object",
            "properties": {
              "status": { "type": "string", "enum": ["ready", "review"] },
              "verdict": { "type": "string", "enum": ["present", "absent"] },
              "probability": { "type": "number", "minimum": 0, "maximum": 1 },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "required": ["status", "verdict", "probability", "confidence"],
            "additionalProperties": false
          },
          "statesBoundaryIssues": {
            "type": "object",
            "properties": {
              "status": { "type": "string", "enum": ["ready", "review"] },
              "verdict": { "type": "string", "enum": ["present", "absent"] },
              "probability": { "type": "number", "minimum": 0, "maximum": 1 },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "required": ["status", "verdict", "probability", "confidence"],
            "additionalProperties": false
          },
          "statesAssociationRules": {
            "type": "object",
            "properties": {
              "status": { "type": "string", "enum": ["ready", "review"] },
              "verdict": { "type": "string", "enum": ["present", "absent"] },
              "probability": { "type": "number", "minimum": 0, "maximum": 1 },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "required": ["status", "verdict", "probability", "confidence"],
            "additionalProperties": false
          }
        },
        "required": [
          "statesKnownDefects",
          "statesPriorRepairs",
          "statesEnvironmentalHazards",
          "statesBoundaryIssues",
          "statesAssociationRules"
        ],
        "additionalProperties": false
      }
    },
    "required": ["model", "usage", "status", "detected", "labels"],
    "additionalProperties": false
  }
}
