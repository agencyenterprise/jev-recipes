{
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "objective": { "type": "string" },
      "question": { "type": "string" },
      "minConfidence": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "required": ["objective", "question"]
  },
  "resultSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "model": { "type": "string" },
      "usage": {
        "type": "object",
        "properties": {
          "input_tokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "output_tokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        },
        "required": ["input_tokens", "output_tokens"],
        "additionalProperties": false
      },
      "status": { "type": "string", "enum": ["ready", "review"] },
      "probability": { "type": "number", "minimum": 0, "maximum": 1 },
      "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
      "verdict": { "type": "string", "enum": ["assesses", "misses"] }
    },
    "required": ["model", "usage", "status", "probability", "confidence", "verdict"],
    "additionalProperties": false
  }
}
