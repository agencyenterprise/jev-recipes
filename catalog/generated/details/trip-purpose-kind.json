{
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "message": { "type": "string" },
      "context": { "type": "string" },
      "minConfidence": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "required": ["message"]
  },
  "resultSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "model": { "type": "string" },
      "usage": {
        "type": "object",
        "properties": {
          "input_tokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "output_tokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        },
        "required": ["input_tokens", "output_tokens"],
        "additionalProperties": false
      },
      "status": { "type": "string", "enum": ["ready", "review"] },
      "verdict": {
        "type": "string",
        "enum": ["business", "leisure", "family_visit", "medical", "relocation", "event", "unclear"]
      },
      "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
      "probabilities": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "enum": [
            "business",
            "leisure",
            "family_visit",
            "medical",
            "relocation",
            "event",
            "unclear"
          ]
        },
        "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 },
        "required": [
          "business",
          "leisure",
          "family_visit",
          "medical",
          "relocation",
          "event",
          "unclear"
        ]
      }
    },
    "required": ["model", "usage", "status", "verdict", "confidence", "probabilities"],
    "additionalProperties": false
  }
}
