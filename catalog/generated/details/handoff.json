{
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "request": { "type": "string" },
      "context": { "type": "string" },
      "rules": {
        "minItems": 1,
        "maxItems": 50,
        "type": "array",
        "items": {
          "type": "object",
          "properties": { "id": { "type": "string" }, "description": { "type": "string" } },
          "required": ["id", "description"]
        }
      },
      "minConfidence": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "required": ["request", "rules"]
  },
  "resultSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "model": { "type": "string" },
      "usage": {
        "type": "object",
        "properties": {
          "input_tokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "output_tokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        },
        "required": ["input_tokens", "output_tokens"],
        "additionalProperties": false
      },
      "status": { "type": "string", "enum": ["ready", "review"] },
      "decision": { "type": "string", "enum": ["human", "continue", "review"] },
      "matchedRules": { "type": "array", "items": { "type": "string" } },
      "uncertainRules": { "type": "array", "items": { "type": "string" } },
      "checks": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "status": { "type": "string", "enum": ["ready", "review"] },
            "verdict": { "type": "string", "enum": ["matches", "does_not_match", "unclear"] },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "probabilities": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "enum": ["matches", "does_not_match", "unclear"]
              },
              "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 },
              "required": ["matches", "does_not_match", "unclear"]
            }
          },
          "required": ["id", "status", "verdict", "confidence", "probabilities"],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "model",
      "usage",
      "status",
      "decision",
      "matchedRules",
      "uncertainRules",
      "checks"
    ],
    "additionalProperties": false
  }
}
