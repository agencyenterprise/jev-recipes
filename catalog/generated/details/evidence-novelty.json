{
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "passage": { "type": "string" },
      "existingEvidence": {
        "minItems": 1,
        "maxItems": 50,
        "type": "array",
        "items": {
          "type": "object",
          "properties": { "id": { "type": "string" }, "text": { "type": "string" } },
          "required": ["id", "text"]
        }
      },
      "question": { "type": "string" },
      "minConfidence": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "required": ["passage", "existingEvidence", "question"]
  },
  "resultSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "model": { "type": "string" },
      "usage": {
        "type": "object",
        "properties": {
          "input_tokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "output_tokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        },
        "required": ["input_tokens", "output_tokens"],
        "additionalProperties": false
      },
      "status": { "type": "string", "enum": ["ready", "review"] },
      "verdict": {
        "type": "string",
        "enum": ["adds_information", "repeats_information", "irrelevant", "unclear"]
      },
      "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
      "probabilities": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "enum": ["adds_information", "repeats_information", "irrelevant", "unclear"]
        },
        "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 },
        "required": ["adds_information", "repeats_information", "irrelevant", "unclear"]
      }
    },
    "required": ["model", "usage", "status", "verdict", "confidence", "probabilities"],
    "additionalProperties": false
  }
}
