{
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "summary": { "type": "string" },
      "points": {
        "minItems": 1,
        "maxItems": 50,
        "type": "array",
        "items": {
          "type": "object",
          "properties": { "id": { "type": "string" }, "text": { "type": "string" } },
          "required": ["id", "text"]
        }
      },
      "minConfidence": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "required": ["summary", "points"]
  },
  "resultSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "model": { "type": "string" },
      "usage": {
        "type": "object",
        "properties": {
          "input_tokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "output_tokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        },
        "required": ["input_tokens", "output_tokens"],
        "additionalProperties": false
      },
      "status": { "type": "string", "enum": ["ready", "review"] },
      "allPreserved": { "type": "boolean" },
      "checks": {
        "minItems": 1,
        "maxItems": 50,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "status": { "type": "string", "enum": ["ready", "review"] },
            "verdict": { "type": "string", "enum": ["preserved", "partial", "missing", "unclear"] },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "probabilities": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "enum": ["preserved", "partial", "missing", "unclear"]
              },
              "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 },
              "required": ["preserved", "partial", "missing", "unclear"]
            }
          },
          "required": ["id", "status", "verdict", "confidence", "probabilities"],
          "additionalProperties": false
        }
      }
    },
    "required": ["model", "usage", "status", "allPreserved", "checks"],
    "additionalProperties": false
  }
}
