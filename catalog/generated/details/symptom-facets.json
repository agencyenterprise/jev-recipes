{
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "message": { "type": "string" },
      "minConfidence": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "required": ["message"]
  },
  "resultSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "model": { "type": "string" },
      "usage": {
        "type": "object",
        "properties": {
          "input_tokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "output_tokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        },
        "required": ["input_tokens", "output_tokens"],
        "additionalProperties": false
      },
      "status": { "type": "string", "enum": ["ready", "review"] },
      "detected": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "statesOnset",
            "statesSeverity",
            "statesDuration",
            "statesModifiers",
            "statesPriorTreatment"
          ]
        }
      },
      "labels": {
        "type": "object",
        "properties": {
          "statesOnset": {
            "type": "object",
            "properties": {
              "status": { "type": "string", "enum": ["ready", "review"] },
              "verdict": { "type": "string", "enum": ["present", "absent"] },
              "probability": { "type": "number", "minimum": 0, "maximum": 1 },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "required": ["status", "verdict", "probability", "confidence"],
            "additionalProperties": false
          },
          "statesSeverity": {
            "type": "object",
            "properties": {
              "status": { "type": "string", "enum": ["ready", "review"] },
              "verdict": { "type": "string", "enum": ["present", "absent"] },
              "probability": { "type": "number", "minimum": 0, "maximum": 1 },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "required": ["status", "verdict", "probability", "confidence"],
            "additionalProperties": false
          },
          "statesDuration": {
            "type": "object",
            "properties": {
              "status": { "type": "string", "enum": ["ready", "review"] },
              "verdict": { "type": "string", "enum": ["present", "absent"] },
              "probability": { "type": "number", "minimum": 0, "maximum": 1 },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "required": ["status", "verdict", "probability", "confidence"],
            "additionalProperties": false
          },
          "statesModifiers": {
            "type": "object",
            "properties": {
              "status": { "type": "string", "enum": ["ready", "review"] },
              "verdict": { "type": "string", "enum": ["present", "absent"] },
              "probability": { "type": "number", "minimum": 0, "maximum": 1 },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "required": ["status", "verdict", "probability", "confidence"],
            "additionalProperties": false
          },
          "statesPriorTreatment": {
            "type": "object",
            "properties": {
              "status": { "type": "string", "enum": ["ready", "review"] },
              "verdict": { "type": "string", "enum": ["present", "absent"] },
              "probability": { "type": "number", "minimum": 0, "maximum": 1 },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "required": ["status", "verdict", "probability", "confidence"],
            "additionalProperties": false
          }
        },
        "required": [
          "statesOnset",
          "statesSeverity",
          "statesDuration",
          "statesModifiers",
          "statesPriorTreatment"
        ],
        "additionalProperties": false
      }
    },
    "required": ["model", "usage", "status", "detected", "labels"],
    "additionalProperties": false
  }
}
