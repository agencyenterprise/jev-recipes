{
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "request": { "type": "string" },
      "minConfidence": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "required": ["request"]
  },
  "resultSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "model": { "type": "string" },
      "usage": {
        "type": "object",
        "properties": {
          "input_tokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "output_tokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        },
        "required": ["input_tokens", "output_tokens"],
        "additionalProperties": false
      },
      "status": { "type": "string", "enum": ["ready", "review"] },
      "detected": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "statesDates",
            "statesPartySize",
            "statesAccessibilityNeeds",
            "statesBudget",
            "statesOccasion"
          ]
        }
      },
      "labels": {
        "type": "object",
        "properties": {
          "statesDates": {
            "type": "object",
            "properties": {
              "status": { "type": "string", "enum": ["ready", "review"] },
              "verdict": { "type": "string", "enum": ["present", "absent"] },
              "probability": { "type": "number", "minimum": 0, "maximum": 1 },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "required": ["status", "verdict", "probability", "confidence"],
            "additionalProperties": false
          },
          "statesPartySize": {
            "type": "object",
            "properties": {
              "status": { "type": "string", "enum": ["ready", "review"] },
              "verdict": { "type": "string", "enum": ["present", "absent"] },
              "probability": { "type": "number", "minimum": 0, "maximum": 1 },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "required": ["status", "verdict", "probability", "confidence"],
            "additionalProperties": false
          },
          "statesAccessibilityNeeds": {
            "type": "object",
            "properties": {
              "status": { "type": "string", "enum": ["ready", "review"] },
              "verdict": { "type": "string", "enum": ["present", "absent"] },
              "probability": { "type": "number", "minimum": 0, "maximum": 1 },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "required": ["status", "verdict", "probability", "confidence"],
            "additionalProperties": false
          },
          "statesBudget": {
            "type": "object",
            "properties": {
              "status": { "type": "string", "enum": ["ready", "review"] },
              "verdict": { "type": "string", "enum": ["present", "absent"] },
              "probability": { "type": "number", "minimum": 0, "maximum": 1 },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "required": ["status", "verdict", "probability", "confidence"],
            "additionalProperties": false
          },
          "statesOccasion": {
            "type": "object",
            "properties": {
              "status": { "type": "string", "enum": ["ready", "review"] },
              "verdict": { "type": "string", "enum": ["present", "absent"] },
              "probability": { "type": "number", "minimum": 0, "maximum": 1 },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "required": ["status", "verdict", "probability", "confidence"],
            "additionalProperties": false
          }
        },
        "required": [
          "statesDates",
          "statesPartySize",
          "statesAccessibilityNeeds",
          "statesBudget",
          "statesOccasion"
        ],
        "additionalProperties": false
      }
    },
    "required": ["model", "usage", "status", "detected", "labels"],
    "additionalProperties": false
  }
}
