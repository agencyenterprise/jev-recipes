{
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "review": { "type": "string" },
      "minConfidence": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "required": ["review"]
  },
  "resultSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "model": { "type": "string" },
      "usage": {
        "type": "object",
        "properties": {
          "input_tokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "output_tokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        },
        "required": ["input_tokens", "output_tokens"],
        "additionalProperties": false
      },
      "status": { "type": "string", "enum": ["ready", "review"] },
      "detected": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "mentionsQuality",
            "mentionsPrice",
            "mentionsShipping",
            "mentionsService",
            "reportsDefect"
          ]
        }
      },
      "labels": {
        "type": "object",
        "properties": {
          "mentionsQuality": {
            "type": "object",
            "properties": {
              "status": { "type": "string", "enum": ["ready", "review"] },
              "verdict": { "type": "string", "enum": ["present", "absent"] },
              "probability": { "type": "number", "minimum": 0, "maximum": 1 },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "required": ["status", "verdict", "probability", "confidence"],
            "additionalProperties": false
          },
          "mentionsPrice": {
            "type": "object",
            "properties": {
              "status": { "type": "string", "enum": ["ready", "review"] },
              "verdict": { "type": "string", "enum": ["present", "absent"] },
              "probability": { "type": "number", "minimum": 0, "maximum": 1 },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "required": ["status", "verdict", "probability", "confidence"],
            "additionalProperties": false
          },
          "mentionsShipping": {
            "type": "object",
            "properties": {
              "status": { "type": "string", "enum": ["ready", "review"] },
              "verdict": { "type": "string", "enum": ["present", "absent"] },
              "probability": { "type": "number", "minimum": 0, "maximum": 1 },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "required": ["status", "verdict", "probability", "confidence"],
            "additionalProperties": false
          },
          "mentionsService": {
            "type": "object",
            "properties": {
              "status": { "type": "string", "enum": ["ready", "review"] },
              "verdict": { "type": "string", "enum": ["present", "absent"] },
              "probability": { "type": "number", "minimum": 0, "maximum": 1 },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "required": ["status", "verdict", "probability", "confidence"],
            "additionalProperties": false
          },
          "reportsDefect": {
            "type": "object",
            "properties": {
              "status": { "type": "string", "enum": ["ready", "review"] },
              "verdict": { "type": "string", "enum": ["present", "absent"] },
              "probability": { "type": "number", "minimum": 0, "maximum": 1 },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "required": ["status", "verdict", "probability", "confidence"],
            "additionalProperties": false
          }
        },
        "required": [
          "mentionsQuality",
          "mentionsPrice",
          "mentionsShipping",
          "mentionsService",
          "reportsDefect"
        ],
        "additionalProperties": false
      }
    },
    "required": ["model", "usage", "status", "detected", "labels"],
    "additionalProperties": false
  }
}
