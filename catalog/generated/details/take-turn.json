{
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "player": {
        "type": "string",
        "description": "The player whose current turn or reaction eligibility should be assessed."
      },
      "rules": {
        "type": "string",
        "description": "Applicable turn, phase, reaction, and participation rules."
      },
      "environment": {
        "type": "string",
        "description": "The current game snapshot available to the player, after the supplied history."
      },
      "history": {
        "maxItems": 100,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "player": {
              "type": "string",
              "description": "The player who took the recorded action."
            },
            "action": {
              "type": "string",
              "description": "The observed action, including its known outcome when relevant."
            }
          },
          "required": ["player", "action"]
        },
        "description": "Optional observed actions by any players, oldest first. May be empty or incomplete."
      },
      "minConfidence": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "required": ["player", "rules", "environment"]
  },
  "resultSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "model": { "type": "string" },
      "usage": {
        "type": "object",
        "properties": {
          "input_tokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "output_tokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        },
        "required": ["input_tokens", "output_tokens"],
        "additionalProperties": false
      },
      "status": { "type": "string", "enum": ["ready", "review"] },
      "verdict": { "type": "string", "enum": ["act", "wait", "inactive", "unclear"] },
      "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
      "probabilities": {
        "type": "object",
        "propertyNames": { "type": "string", "enum": ["act", "wait", "inactive", "unclear"] },
        "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 },
        "required": ["act", "wait", "inactive", "unclear"]
      }
    },
    "required": ["model", "usage", "status", "verdict", "confidence", "probabilities"],
    "additionalProperties": false
  }
}
